{
  "name": "telecom-empire",
  "private": true,
  "version": "1.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tools/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tools/**/*.ts\"",
    "e2e": "playwright test",
    "performance": "playwright test --config playwright.performance.config.ts",
    "performance:network": "esbuild tools/network-benchmark.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/network-benchmark.mjs --log-level=error && node node_modules/.cache/network-benchmark.mjs",
    "check": "esbuild tools/checks.ts --bundle --platform=node --format=esm --define:import.meta.env.VITE_E2E=false --outfile=node_modules/.cache/checks.mjs --log-level=error && node node_modules/.cache/checks.mjs",
    "balance": "esbuild tools/balance.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/balance.mjs --log-level=error && node node_modules/.cache/balance.mjs",
    "release:audit": "esbuild tools/release-audit.ts --bundle --platform=node --format=esm --define:import.meta.env.VITE_E2E=false --outfile=node_modules/.cache/release-audit.mjs --log-level=error && node node_modules/.cache/release-audit.mjs",
    "mobile-check": "esbuild tools/mobile-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/mobile.mjs --log-level=error && node node_modules/.cache/mobile.mjs",
    "audit": "npm audit --audit-level=moderate",
    "verify-commits": "bash tools/verify-commits.sh",
    "build:e2e": "tsc -b && vite build --mode e2e --outDir dist-e2e"
  },
  "dependencies": {
    "framer-motion": "^11.11.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "postcss": "^8.4.47",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.3"
  }
}
